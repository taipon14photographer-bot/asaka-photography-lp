---
import { navItems, siteLinks } from "../data/siteContent";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const mobileNavItems = [
  { label: "About", href: "/about/" },
  { label: "Works", href: "/works/" },
  { label: "Price", href: "/price/" },
  { label: "Flow", href: "/flow/" },
  { label: "FAQ", href: "/faq/" },
];
---

<header class="site-header" aria-label="サイトヘッダー">
  <a class="site-header__brand" href="/" aria-label="ASAKA Photography トップへ">
    <img src="/images/brand/asaka-photography-logo-horizontal.png" alt="ASAKA Photography" width="180" height="52" />
  </a>
  <nav class="site-header__nav site-header__nav--desktop" aria-label="主要ページ">
    {navItems.map((item) => <a class:list={[isActive(item.href) && "is-active"]} href={item.href}>{item.label}</a>)}
  </nav>
  <a class="site-header__line" href={siteLinks.line} target="_blank" rel="noreferrer">LINE相談</a>
  <details class="site-header__mobile-menu">
    <summary aria-controls="mobile-navigation">メニュー</summary>
    <nav id="mobile-navigation" class="site-header__menu-panel" aria-label="主要ページ（スマホ）">
      {mobileNavItems.map((item) => (
        <a class:list={[isActive(item.href) && "is-active"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>

<style is:global>
  .site-header__mobile-menu {
    display: none;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  @media (max-width: 719px) {
    header.site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: 0.5rem;
    }

    .site-header .site-header__brand {
      min-height: 44px;
    }

    .site-header .site-header__line {
      min-height: 44px;
      grid-column: 2;
      grid-row: 1;
    }

    .site-header__mobile-menu {
      display: block;
      grid-column: 3;
      grid-row: 1;
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 700;
    }

    .site-header__mobile-menu summary {
      display: flex;
      min-height: 44px;
      min-width: 44px;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0 0.65rem;
      line-height: 1.2;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255, 253, 248, 0.9);
      color: var(--ink);
      cursor: pointer;
      list-style: none;
    }

    .site-header__mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .site-header__mobile-menu summary::after {
      width: 0.35rem;
      height: 0.35rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      content: "";
      transform: rotate(45deg);
    }

    .site-header__mobile-menu[open] summary::after {
      transform: rotate(225deg);
    }

    .site-header__menu-panel {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      gap: 0.25rem;
      max-height: calc(100svh - 60px);
      overflow-y: auto;
      padding: 0.5rem clamp(0.65rem, 3.5vw, 1rem);
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      color: var(--muted);
      box-shadow: var(--soft-shadow);
    }

    .site-header__menu-panel a {
      display: flex;
      min-height: 44px;
      align-items: center;
      padding-inline: 0.75rem;
      text-decoration: none;
    }

    .site-header__menu-panel a.is-active {
      color: var(--gold-deep);
    }

    .site-header__mobile-menu summary:focus-visible,
    .site-header__menu-panel a:focus-visible {
      outline: 2px solid var(--gold-deep);
      outline-offset: -2px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const menu = header?.querySelector<HTMLDetailsElement>(".site-header__mobile-menu");
  const toggle = menu?.querySelector<HTMLElement>("summary");
  const panel = menu?.querySelector<HTMLElement>(".site-header__menu-panel");

  if (header && menu && toggle && panel) {
    const desktopNav = header.querySelector<HTMLElement>(".site-header__nav--desktop");
    let focusedHeaderControl: HTMLElement | null = null;
    document.addEventListener("focusin", (event) => {
      focusedHeaderControl = event.target instanceof HTMLElement && header.contains(event.target) ? event.target : null;
    });

    const closeMenu = (restoreFocus = false) => {
      menu.open = false;
      toggle.setAttribute("aria-expanded", "false");
      if (restoreFocus) toggle.focus();
    };

    toggle.setAttribute("aria-expanded", String(menu.open));
    menu.addEventListener("toggle", () => {
      toggle.setAttribute("aria-expanded", String(menu.open));
      if (menu.open) panel.querySelector<HTMLAnchorElement>("a")?.focus();
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        event.preventDefault();
        closeMenu(true);
      }
    });
    menu.addEventListener("focusout", (event) => {
      if (menu.open && event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) {
        closeMenu();
      }
    });
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) closeMenu();
    });
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) focusedHeaderControl = null;
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        closeMenu();
        requestAnimationFrame(() => {
          if (panel.contains(document.activeElement)) toggle.focus();
        });
      }
    });
    window.matchMedia("(min-width: 720px)").addEventListener("change", (event) => {
      // A control hidden by the new breakpoint can lose focus before this event fires.
      const focusSource = document.activeElement === document.body ? focusedHeaderControl : document.activeElement;
      if (event.matches) {
        const wasInside = menu.contains(focusSource);
        const href = focusSource?.getAttribute("href");
        closeMenu();
        if (wasInside) {
          const desktopLink = Array.from(header.querySelectorAll<HTMLAnchorElement>(".site-header__nav--desktop a"))
            .find((link) => link.getAttribute("href") === href);
          (desktopLink ?? header.querySelector<HTMLAnchorElement>(".site-header__brand"))?.focus();
        }
      } else if (desktopNav?.contains(focusSource)) {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>
