---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "./Photo.astro";
import Safety from "./Safety.astro";
import Story from "./Story.astro";
import Plans from "./Plans.astro";
import Contact from "./Contact.astro";
import LineLink from "./LineLink.astro";
import { photos, plans } from "../../data/newborn";
import { newbornArtGallery } from "../../data/newbornArtGallery";
import { newbornServiceTerms } from "../../data/siteContent";
import "../../styles/newborn.css";
import { newbornBuild } from "../../data/newbornBuild";
import { newbornOgp } from "../../data/newbornOgp";
interface Props {
  kind: "overview" | "lifestyle" | "art";
  comparison?: "lifestyle-a" | "lifestyle-b" | "story-a" | "story-b";
}
const { kind, comparison } = Astro.props;
const ogp = newbornOgp[newbornBuild.ogpVariant][kind];
const overview = kind === "overview";
const art = kind === "art";
const name = overview ? "Newborn" : art ? "Art Newborn" : "Lifestyle Newborn";
const title = overview ? "ニューボーン撮影 | 静岡・伊豆のASAKA Photography" : `${name} | 静岡・伊豆のニューボーン撮影 | ASAKA Photography`;
const activePlan = plans.find(plan => plan.key === `${kind}_newborn`);
const planFacts = activePlan ? `${activePlan.price}円（税込）／ ${newbornServiceTerms.durationLabel} ${activePlan.duration} ／ ${activePlan.delivery}` : "";
const description = overview ? "静岡・伊豆のご自宅でニューボーン撮影。自然体のLifestyle、作品として残すArt、両方を残すNewborn Story。料金・撮影の流れ・赤ちゃんへの配慮をご紹介します。" : art ? `おくるみ・カゴ・クッションで、生まれたての姿を作品に。${name}は税込${activePlan!.price}円、${activePlan!.duration}・${activePlan!.delivery}。撮影作品と赤ちゃんへの配慮をご紹介します。` : `ご自宅での抱っこやふれあいを自然体で残す${name}。税込${activePlan!.price}円、${activePlan!.duration}・${activePlan!.delivery}。家族写真や撮影の進め方をご紹介します。`;
const gallery = art ? newbornArtGallery : comparison === "lifestyle-b" ? [photos.shoulder, photos.parents, photos.bath, photos.siblings, photos.feeding] : [photos.parents, photos.shoulder, photos.bath, photos.siblings, photos.feeding];
const photoVariant = comparison === "story-b" ? "art-lifestyle" : "current";
const comparisonLabel = comparison ? {
  "lifestyle-a": "Lifestyle A：現行順",
  "lifestyle-b": "Lifestyle B：L04を2枚目へ",
  "story-a": "Story A：母子＋生活風景（現行）",
  "story-b": "Story B：Art作品＋生活風景（比較案）",
}[comparison] : undefined;
const steps = overview ? [
  ["LINEでご相談", "出産予定日・地域・残したい写真をお知らせください。プラン選びから一緒に考えます。"],
  ["撮影前の打ち合わせ", "日程や撮影場所、必要な準備を確認。追加費用がある場合も、予約前にご案内します。"],
  ["ご自宅での撮影", "赤ちゃんの様子に合わせて、授乳や休憩を挟みながら進めます。"],
  ["一枚ずつ整えて、お届け", "セレクト・編集した写真をオンラインで納品。通常は撮影日から2週間以内が目安です。"],
] : art ? [
  ["おくるみ", "小さな身体を包んだ姿を、布の質感とともに。"],
  ["カゴ・クッション", "小物と背景を整え、赤ちゃんの表情や身体の小ささを引き立てます。"],
  ["小さな手足や、ご家族との一枚", "パーツカットに加え、家族・兄弟写真も撮影内容に含みます。ご希望を伺い、赤ちゃんの様子に合わせて進めます。"],
] : [
  ["いつもの場所を、撮影場所に。", "光の入り方や過ごしやすい場所を事前に相談し、ご自宅へ伺います。"],
  ["抱っこも、泣き顔も、その日の時間。", "ポーズに慣れていなくても大丈夫。ふれあいながら、必要なところだけ声をかけて整えます。"],
  ["生活の場面も、ご希望に合わせて。", "授乳や沐浴など、残したい場面があれば事前にご相談ください。赤ちゃんとご家族の様子を見ながら進めます。"],
];
---
<BaseLayout title={title} description={description} noindex={newbornBuild.review} image={ogp.image.src} imageAlt={ogp.alt} imageWidth={ogp.image.width} imageHeight={ogp.image.height}>
  <div class="nb-page">
    {newbornBuild.review && <aside class="nb-review" aria-label="ローカルレビューの状態">LOCAL PREVIEW <span>／ {comparisonLabel ? `${comparisonLabel}・採用待ち` : "掲載写真・内容はレビュー待ち"}</span></aside>}
    <nav class="nb-nav" aria-label="ニューボーン撮影のページ">
      <a href="/newborn/" aria-current={overview ? "page" : undefined}>Newborn</a><a href="/newborn/lifestyle/" aria-current={kind === "lifestyle" ? "page" : undefined}>Lifestyle</a><a href="/newborn/art/" aria-current={art ? "page" : undefined}>Art</a><a href="/newborn/#story">Story</a>
    </nav>
    <section class="nb-hero" aria-labelledby="newborn-title">
      <div class="nb-hero-copy"><p class="eyebrow">{name} <span class="nb-hero-location">Shizuoka / Izu</span></p>
        <h1 id="newborn-title">{overview ? <>生まれたばかりの今を、<br />家族の記憶に。</> : art ? <>生まれたての小ささを、<br />一枚の作品に。</> : <>はじめての日々の、<br />いつもの幸せ。</>}</h1>
        <p>{overview ? "小さな手も、抱きしめる腕も。今しかない姿と、家族の時間を、ご自宅でゆっくり残します。" : art ? "おくるみや小物で、そっと整える。赤ちゃんのペースを大切に、生まれたての姿を丁寧に残します。" : "抱っこの温もり、見つめるまなざし。暮らしの中にある、家族らしい時間を写真に。"}</p>
        <div class="nb-hero-actions"><LineLink plan={overview ? "not_selected" : `${kind}_newborn`} placement="hero" label="LINEで相談する" /><a class="text-link" href={overview ? "#styles" : "#gallery"}>{overview ? "撮影スタイルを見る" : "作品を見る"} ↓</a></div>
        <p class="nb-small">{overview ? "Lifestyle ／ Art ／ Newborn Story" : planFacts}</p>
        {!overview && <p class="nb-small">{newbornServiceTerms.durationNote}</p>}
      </div>
      <div class="nb-hero-image"><Photo photo={art ? photos.basket : photos.family} hero={true} sizes="(min-width: 960px) 58vw, 100vw" /></div>
    </section>
    <section class="nb-section nb-intro"><div class="nb-inner nb-reading"><p class="eyebrow">{overview ? "Our thoughts" : "Concept"}</p><h2>{overview ? <>写真を見返すたび、<br />この頃の温度まで思い出せるように。</> : art ? <>飾りたいのは、<br />この時だけの姿。</> : <>特別に作らなくても、<br />残しておきたい時間がある。</>}</h2><p>{overview ? "慣れない毎日の中で、あっという間に過ぎていく新生児期。赤ちゃんの姿だけでなく、そばにいるご家族のまなざしや、その日の空気まで残したいと思っています。" : art ? "小さな手、丸まった身体、眠っている横顔。色や小物を控えめに整えて、赤ちゃんの存在が主役になる一枚を。無理にポーズを完成させることより、心地よく過ごせることを大切にします。" : "家の光、いつもの抱き方、きょうだいが近づく距離。暮らしの中には、家族にしかない美しさがあります。上手に写ろうとしなくて大丈夫。今のご家族らしさを、一緒に見つけていきます。"}</p></div></section>
    {overview ? <section class="nb-section nb-warm" id="styles" aria-labelledby="styles-title"><div class="nb-inner"><div class="nb-heading"><p class="eyebrow">Two styles</p><h2 id="styles-title">どんな「今」を、残したいですか。</h2><p>自然な家族の時間と、丁寧に整えた作品。好きな写真から選んでみてください。</p></div><div class="nb-style-grid">{plans.slice(0,2).map(plan => <article><a href={plan.href} class="nb-image-link" aria-label={`${plan.name}の作品と内容を見る`}><Photo photo={plan.image} /></a><div class="nb-style-copy"><p class="eyebrow">{plan.name}</p><h3>{plan.label}</h3><p>{plan.intro}</p><p class="nb-small">{plan.price}円（税込）／ {plan.duration}</p><a class="text-link" href={plan.href}>{plan.name}を詳しく見る →</a></div></article>)}</div></div></section> : <section class="nb-section" id="gallery" aria-labelledby="gallery-title"><div class="nb-inner"><div class="nb-heading"><p class="eyebrow">Gallery</p><h2 id="gallery-title">{art ? "小さな姿に、静かな余白を。" : "家族の時間に、そっと寄り添う。"}</h2>{art && <p class="nb-small">赤ちゃんの身体の支持に配慮し、必要な場面では合成で仕上げます。写真の姿勢をご家庭で再現しないでください。</p>}</div><div class="nb-gallery">{gallery.map(photo => <figure><Photo photo={photo} />{art && photo === photos.embrace && <figcaption class="nb-small">Art撮影で、ご家族と。おくるみの姿も、一緒に残します。</figcaption>}</figure>)}</div><a class="text-link" href="/works/#newborn">Newbornの作品をもっと見る →</a></div></section>}
    {overview ? <Story photoVariant={photoVariant} /> : <section class="nb-section nb-warm" aria-labelledby="experience-title"><div class="nb-inner"><div class="nb-heading"><p class="eyebrow">{art ? "What we photograph" : "The experience"}</p><h2 id="experience-title">{art ? "その日の様子から、撮影を組み立てます。" : "いつもの場所で、いつものペースで。"}</h2></div><ol class="nb-steps">{steps.map(([heading,body],i) => <li><span class="nb-step-number">0{i+1}</span><h3>{heading}</h3><p>{body}</p></li>)}</ol><a class="text-link" href={`/price/#${art ? "art-newborn" : "lifestyle-newborn"}`}>料金・納品内容を詳しく見る →</a></div></section>}
    <Safety />
    {overview && <Plans />}
    {overview && <section class="nb-section nb-warm" aria-labelledby="flow-title"><div class="nb-inner"><div class="nb-heading"><p class="eyebrow">Flow</p><h2 id="flow-title">相談から、お届けまで。</h2></div><ol class="nb-steps nb-steps--four">{steps.map(([heading,body],i) => <li><span class="nb-step-number">0{i+1}</span><h3>{heading}</h3><p>{body}</p></li>)}</ol><a class="text-link" href="/flow/">共通の撮影の流れを見る →</a></div></section>}
    <Contact kind={kind} />
    <div class="nb-return"><a href="/newborn/">Newborn総合</a><a href="/works/#newborn">これまでのNewborn作品</a><a href="/price/#newborn">共通料金ページ</a></div>
  </div>
</BaseLayout>
