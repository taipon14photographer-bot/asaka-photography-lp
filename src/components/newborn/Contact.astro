---
import { commonFaq } from "../../data/newborn";
import LineLink from "./LineLink.astro";
interface Props { kind: "overview" | "lifestyle" | "art"; }
const { kind } = Astro.props;
const specific = kind === "art" ? [
  { q: "ArtとStoryは、何が違いますか？", a: "Artはおくるみや小物を使った作品が中心で、家族・兄弟写真も含みます。StoryはArtに加え、抱っこや家族のふれあい、ご自宅で過ごす場面まで幅広く残すプランです。授乳・沐浴などはご希望と当日の様子に応じます。" },
  { q: "希望のポーズや小物は相談できますか？", a: "おくるみ・カゴ・クッションなど、ご希望の雰囲気を事前に伺います。赤ちゃんの姿勢や身体の支持に配慮し、当日の様子に合わせて内容を調整します。" },
] : kind === "lifestyle" ? [
  { q: "おくるみなどのArt作品も一緒に残せますか？", a: "Art作品と自然な家族のふれあいの両方をご希望の場合は、Newborn Storyをご案内しています。残したい場面をLINEで教えてください。" },
] : [
  { q: "Lifestyle・Art・Storyは、どう選べばよいですか？", a: "自然な家族の写真が中心ならLifestyle、おくるみや小物を使う作品が中心ならArtが目安です。Art作品に加え、抱っこや日常の場面まで幅広く残すならStory。Artにも家族・兄弟写真を含むため、ご家族と写れるかだけでなく、残したい場面からお選びいただけます。" },
];
const plan = kind === "overview" ? "not_selected" : `${kind}_newborn`;
---
<section class="nb-section nb-faq" id="faq" aria-labelledby="faq-title"><div class="nb-inner nb-reading"><div class="nb-heading"><p class="eyebrow">FAQ</p><h2 id="faq-title">撮影前の、気になること。</h2></div>{[...specific,...commonFaq].map(faq => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}<a class="text-link" href="/faq/">そのほかのよくある質問 →</a></div></section>
<section class="nb-section nb-contact" aria-labelledby="newborn-contact-title"><div class="nb-inner"><p class="eyebrow">Let’s talk</p><h2 id="newborn-contact-title">まだ決まっていないことから、<br />お話ししませんか。</h2><p>出産予定日、お住まいの地域、気になっている写真。<br />今わかることだけ、LINEで教えてください。</p><LineLink plan={plan} /><p class="nb-small">相談だけでも大丈夫です。すぐに予約を決める必要はありません。</p></div></section>
