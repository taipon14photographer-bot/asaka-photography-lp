---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { photo: { src: ImageMetadata; alt: string }; hero?: boolean; sizes?: string; }
const { photo, hero = false, sizes = "(min-width: 960px) 44vw, 92vw" } = Astro.props;
---
<Image src={photo.src} alt={photo.alt} widths={[360, 640, 960, 1440, 2000]} sizes={sizes} format="webp" quality={82} loading={hero ? "eager" : "lazy"} fetchpriority={hero ? "high" : "auto"} decoding="async" />
