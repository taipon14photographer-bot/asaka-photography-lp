---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { siteContent } from "../data/siteContent";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title = siteContent.meta.title,
  description = siteContent.meta.description,
  image = "/ogp/asaka-photography-og.jpg",
  noindex = false,
  imageAlt = "夕日のすすき野で寄り添う新郎新婦の写真",
  imageWidth,
  imageHeight,
} = Astro.props;
const configuredSite = Astro.site;
const canonicalUrl = new URL(Astro.url.pathname, configuredSite).toString();
const ogImageUrl = new URL(image, configuredSite).toString();
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "G-KCDDX4Y6VP";
const gaHostname = new URL(canonicalUrl).hostname;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ASAKA Photography" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {Astro.props.imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {
      clarityProjectId && (
        <script is:inline define:vars={{ clarityProjectId }}>
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", clarityProjectId);
        </script>
      )
    }
    {
      import.meta.env.PROD && gaMeasurementId && (
        <script is:inline define:vars={{ gaMeasurementId, gaHostname }}>
          // Production HTML can also be served by a local preview server.
          if (window.location.hostname === gaHostname) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function () {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            window.gtag("config", gaMeasurementId);
            const gaScript = document.createElement("script");
            gaScript.async = true;
            gaScript.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaMeasurementId);
            document.head.appendChild(gaScript);
          }
        </script>
      )
    }
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion-ready");
      }
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const analyticsWindow = window as Window & {
        gtag?: (...args: unknown[]) => void;
      };
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = Array.from(document.querySelectorAll<HTMLElement>("[data-animate]"));
      const show = (target: HTMLElement) => target.classList.add("is-visible");
      const isInitiallyVisible = (target: HTMLElement) => {
        const rect = target.getBoundingClientRect();
        return rect.top < window.innerHeight * 0.96 && rect.bottom > 0;
      };

      if (reduceMotion || !("IntersectionObserver" in window)) {
        targets.forEach(show);
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                show(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );

        targets.forEach((target) => {
          if (isInitiallyVisible(target)) {
            show(target);
          } else {
            observer.observe(target);
          }
        });
      }

      // Fixed structural identifiers: never infer context from copy or display order.
      const lineContexts = [
        [".site-header__line", "header", "general", "not_selected"],
        ['[aria-labelledby="hero-title"]', "hero", "general", "not_selected"],
        ['[aria-labelledby="top-voice-title"]', "testimonial", "general", "not_selected"],
        ['[aria-labelledby="top-social-title"]', "social", "general", "not_selected"],
        [".cta-section", "page_end", "general", "not_selected"],
        ['.gallery-section[id="wedding"]', "gallery", "wedding", "not_selected"],
        ['.gallery-section[id="maternity"]', "gallery", "maternity", "not_selected"],
        ['.gallery-section[id="newborn"]', "gallery", "newborn", "not_selected"],
        ['.gallery-section[id="omiyamairi"]', "gallery", "omiyamairi", "not_selected"],
        ['.gallery-section[id="753"]', "gallery", "shichigosan", "not_selected"],
        ['.gallery-section[id="family"]', "gallery", "family", "not_selected"],
        ['[data-line-plan="wedding_casual"]', "plan_card", "wedding", "wedding_casual"],
        ['[data-line-plan="wedding_essential"]', "plan_card", "wedding", "wedding_essential"],
        ['[data-line-plan="wedding_signature"]', "plan_card", "wedding", "wedding_signature"],
        ['[id="maternity-plan"]', "plan_card", "maternity", "maternity"],
        ['[id="family-plan"]', "plan_card", "family", "family"],
        ['[id="lifestyle-newborn"]', "plan_card", "newborn", "lifestyle_newborn"],
        ['[id="art-newborn"]', "plan_card", "newborn", "art_newborn"],
        ['[id="additional-costs"]', "additional_costs", "general", "not_selected"],
        ['[aria-labelledby="not-found-title"]', "not_found", "general", "not_selected"],
      ] as const;

      document.querySelectorAll<HTMLAnchorElement>('a[href^="https://lin.ee/"]').forEach((link) => {
        const context = lineContexts.find(([selector]) => link.closest(selector));
        if (!context) return;
        const [, placement, genre, plan] = context;

        link.addEventListener("click", () => {
          try {
            analyticsWindow.gtag?.("event", "line_click", {
              page_path: window.location.pathname,
              placement,
              genre,
              plan,
            });
          } catch {
            // Analytics must never interrupt the native LINE link behavior.
          }
        });
      });
    </script>
  </body>
</html>
